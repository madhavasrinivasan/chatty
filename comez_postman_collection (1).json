							{
								"key": "x-custom-domain",
								"value": "false",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/editor/ecommerce/getallproducts",
							"host": [
								"{{base_url}}"
							],
							"path": [
								"editor",
								"ecommerce",
								"getallproducts"
							]
