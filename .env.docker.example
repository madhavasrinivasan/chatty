# Copy into .env on the server (never commit real passwords).
# .env is gitignored.

POSTGRES_USER=chatty
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=chatty
POSTGRES_PORT=5432

# App also needs these (and JWT, Gemini, TypeSafe, etc. from your real .env):
# DB_URL is overridden by compose for api/worker to point at service "db".
# Keep a local DB_URL for non-docker runs if you want:
# DB_URL=postgresql://chatty:change-me-strong-password@localhost:5432/chatty

# Website embed snippet URLs shown in the admin panel.
PUBLIC_API_BASE_URL=https://api.symma.shop
WIDGET_SCRIPT_URL=https://widget.symma.shop/chatbot.js
